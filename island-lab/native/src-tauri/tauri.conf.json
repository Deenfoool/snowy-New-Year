{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Island Lab",
  "version": "0.1.0",
  "identifier": "dev.deenfoool.islandlab",
  "build": {
    "beforeDevCommand": "node scripts/prepare.mjs",
    "beforeBuildCommand": "node scripts/prepare.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Island Lab",
        "width": 360,
        "height": 75,
        "decorations": false,
        "transparent": true,
        "noRedirectionBitmap": true,
        "alwaysOnTop": false,
        "resizable": false,
        "shadow": false,
        "center": true,
        "alwaysOnBottom": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https://lrclib.net https://geocoding-api.open-meteo.com https://api.open-meteo.com; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
